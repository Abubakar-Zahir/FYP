# Names only (rules.md 6.1). Copy to infra/.env and fill in. Never commit the copy.

# Local stack
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Optional: change if 5432 or 6379 are taken on your machine
POSTGRES_PORT=
REDIS_PORT=

# App (docs/backend.md)
DATABASE_URL=
REDIS_URL=
SUPABASE_URL=
TOKEN_ENCRYPTION_KEY=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
# LLM: openai_compatible works with OpenRouter and Gemini's OpenAI-compatible endpoint.
# Prices come from the provider's price page. The budget guard refuses to run without them.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_MONTHLY_BUDGET_USD=
LLM_INPUT_USD_PER_MILLION_TOKENS=
LLM_OUTPUT_USD_PER_MILLION_TOKENS=
PEXELS_API_KEY=
SENTRY_DSN=
