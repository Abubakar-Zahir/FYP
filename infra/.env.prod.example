# Names only (rules.md 6.1). On the VPS: copy to infra/.env.prod and fill in. Never commit the copy.

# Domain that points at the VPS, e.g. api.example.com. Caddy gets its HTTPS certificate.
API_DOMAIN=

# Supabase: Project Settings > Database > Connection string > Session pooler.
# Change the scheme to postgresql+asyncpg://
DATABASE_URL=
# Supabase: Project Settings > API > Project URL, e.g. https://abcd.supabase.co
SUPABASE_URL=
# JSON list of allowed frontend origins, e.g. ["https://your-app.vercel.app"]
CORS_ORIGINS=

REDIS_URL=redis://redis:6379/0

# LLM, see infra/.env.example
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_MONTHLY_BUDGET_USD=30
LLM_INPUT_USD_PER_MILLION_TOKENS=
LLM_OUTPUT_USD_PER_MILLION_TOKENS=

# Instagram and token encryption. See apps/api/README.md, Instagram.
TOKEN_ENCRYPTION_KEY=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# The web app's callback page, e.g. https://your-app.vercel.app/connect/instagram
INSTAGRAM_REDIRECT_URI=

# Cloudflare R2: R2 > Manage API tokens. Bucket CORS must allow PUT from the web app (apps/api/README.md).
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

# Phase 2 and 3 models and editing (docs/manual-work.md). Empty paths mean the feature stays off.
COMMENT_MODEL_PATH=
HOOK_SCORER_PATH=
WHISPER_MODEL=small
FFMPEG_PATH=ffmpeg
# MANUAL or SS_PERFORMANCE. Read docs/manual-work.md before changing it.
TRIAL_GRADUATION_STRATEGY=MANUAL

# Error tracking (optional). No personal data or request bodies are sent.
SENTRY_DSN=
ENVIRONMENT=production
