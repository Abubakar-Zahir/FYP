# Names only (rules.md 6.1). On the VPS: copy to infra/.env.prod and fill in. Never commit the copy.

# Domain that points at the VPS, e.g. api.example.com. Caddy gets its HTTPS certificate.
API_DOMAIN=

# Supabase: Project Settings > Database > Connection string > Session pooler.
# Change the scheme to postgresql+asyncpg://
DATABASE_URL=
# Supabase: Project Settings > API > Project URL, e.g. https://abcd.supabase.co
SUPABASE_URL=
# JSON list of allowed frontend origins, e.g. ["https://your-app.vercel.app"]
CORS_ORIGINS=

REDIS_URL=redis://redis:6379/0

# LLM, see infra/.env.example
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_MONTHLY_BUDGET_USD=30
LLM_INPUT_USD_PER_MILLION_TOKENS=
LLM_OUTPUT_USD_PER_MILLION_TOKENS=
